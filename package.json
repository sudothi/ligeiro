{
  "name": "dedos-ligeiros",
  "version": "0.3.0",
  "description": "Jogo de psicopedagogia: a criança vê um número e mexe os dedos na ordem dos algarismos.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.dedosligeiros.app",
    "productName": "Dedos Ligeiros",
    "files": [
      "electron/**",
      "src/**",
      "remote/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Dedos Ligeiros",
      "include": "build/installer.nsh",
      "perMachine": true,
      "createDesktopShortcut": true,
      "artifactName": "Dedos-Ligeiros-Instalador-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.18.0"
  }
}
